{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug with Docker Compose",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": true,
            "restart": true,
            "preLaunchTask": "compose:up",
            "postDebugTask": "compose:down"
        },
        {
            "name": "attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": true,
            "restart": true,
        }
    ]
}
