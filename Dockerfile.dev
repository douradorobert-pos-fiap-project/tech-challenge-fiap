FROM python:3.12-slim

ENV POETRY_VERSION=2.3.2 \
    POETRY_HOME=/opt/poetry \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_NO_INTERACTION=1

RUN pip install "poetry==$POETRY_VERSION" debugpy

WORKDIR /app

COPY pyproject.toml poetry.lock ./
COPY src/ ./src/

RUN poetry install

EXPOSE 8000 5678

ENV PYTHONPATH=/app

CMD ["python", "-m", "debugpy", "--listen", "0.0.0.0:5678", "-m", "uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
