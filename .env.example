APP_NAME="Sistema de Oficina"
APP_VERSION="1.0.0"
APP_ENV=development

# Database (PostgreSQL RDS)
DB_HOST=localhost
DB_PASSWORD=oficina123
DATABASE_URL=postgresql://oficina_admin:${DB_PASSWORD}@${DB_HOST}:5432/oficina

# CPF Validator Lambda
CPF_VALIDATOR_LAMBDA_ARN=arn:aws:lambda:us-east-1:264040538379:function:CpfValidatorTest
AWS_REGION=us-east-1

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# SMTP (optional)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@oficina.com
